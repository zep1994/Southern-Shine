    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.3",
    "@tailwindcss/turbopack": "^4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "cf": "^1.0.0-beta.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
